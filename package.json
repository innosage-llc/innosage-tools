{
  "name": "innosage-tools",
  "version": "0.1.6",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "infisical run -- next dev",
    "prebuild": "node scripts/prepare-video-scissors.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "oxlint && eslint",
    "test:seo": "node scripts/verify-seo.mjs",
    "test:byos-sync": "npm --prefix spikes/byos-sync test",
    "test:byos-remediation": "npm --prefix spikes/byos-remediation test",
    "test:deploy": "node --test scripts/deploy-*.test.mjs",
    "test:recorder": "node --experimental-strip-types --test scripts/recorder.test.ts",
    "test:visual-remix": "node --experimental-strip-types --test scripts/visual-remix.test.ts",
    "test:visual-remix-bridge": "node --experimental-strip-types --test scripts/visual-remix-bridge.test.ts",
    "test:visual-remix-scene-store": "npm --prefix workers/video-scissors-mcp run test:scene-store",
    "test:visual-remix-render": "node --test scripts/visual-remix-render.test.mjs",
    "test:visual-remix-motion": "node --experimental-strip-types --test scripts/visual-remix-motion.test.ts",
    "test:visual-remix-motion-browser": "node --test scripts/visual-remix-motion-browser.test.mjs",
    "test:visual-remix-editor": "node --test scripts/visual-remix-editor.test.mjs",
    "test:meeting-fixer": "node --experimental-strip-types --test scripts/meeting-fixer-progress.test.ts",
    "test:video-scissors": "node --experimental-strip-types --test scripts/video-scissors.test.ts",
    "test:video-scissors-remote": "node --experimental-strip-types --test scripts/video-scissors-remote.test.ts",
    "test:video-scissors-mcp": "npm --prefix workers/video-scissors-mcp test",
    "test:video-scissors-mcp-e2e": "node scripts/video-scissors-mcp-e2e.mjs",
    "test:video-scissors-mcp-e2e:offline": "node --test scripts/video-scissors-mcp-e2e.test.mjs",
    "prepare:video-scissors": "node scripts/prepare-video-scissors.mjs",
    "deploy:staging": "bash scripts/deploy-local.sh staging",
    "deploy:production": "bash scripts/deploy-local.sh production",
    "deploy:execute:staging": "node scripts/deploy-pages.mjs staging",
    "deploy:execute:production": "node scripts/deploy-pages.mjs production",
    "deploy:verify:staging": "node scripts/deploy-pages.mjs verify-staging",
    "test:spec": "mkdir -p test-results && pytest tests/e2e/test_image_joiner_ssot.py --json-report --json-report-file=test-results/report.json -s && python3 scripts/extract_spec.py",
    "prepare": "bash scripts/install-git-hooks.sh",
    "test:visual-remix-scene-auth": "npm --prefix workers/video-scissors-mcp run test:scene-auth",
    "test:visual-remix-transport": "node --test scripts/visual-remix-transport.test.mjs",
    "test:visual-remix-scene-browser": "npm --prefix workers/video-scissors-mcp run test:scene-browser"
  },
  "dependencies": {
    "@ffmpeg/core": "0.12.6",
    "@ffmpeg/ffmpeg": "^0.12.15",
    "@ffmpeg/util": "^0.12.2",
    "@tailwindcss/typography": "^0.5.19",
    "@types/react-syntax-highlighter": "^15.5.13",
    "fix-webm-duration": "^1.0.6",
    "konva": "10.9.0",
    "lucide-react": "^0.563.0",
    "next": "16.1.6",
    "qrcode": "^1.5.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-markdown": "^10.1.0",
    "react-media-recorder": "^1.7.2",
    "react-syntax-highlighter": "^16.1.0",
    "react-zoom-pan-pinch": "^3.7.0",
    "remark-gfm": "^4.0.1",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/dom-mediacapture-record": "^1.0.22",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/wicg-file-system-access": "^2023.10.7",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "husky": "^9.1.7",
    "oxlint": "^1.48.0",
    "playwright": "1.62.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wrangler": "4.149.0"
  }
}
