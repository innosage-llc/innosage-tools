{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "video-scissors-mcp-d-staging",
  "main": "src/index-d.ts",
  "compatibility_date": "2026-10-13",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "vars": { "EXPERIMENT_ENABLED": "false" },
  "assets": { "directory": "../../out", "binding": "ASSETS", "run_worker_first": true },
  "kv_namespaces": [
    { "binding": "OAUTH_KV", "id": "00000000000000000000000000000000" }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "PROJECT_STATE", "class_name": "ProjectStateDO" }
    ]
  },
  "migrations": [
    { "tag": "d-v1-sqlite-project-state", "new_sqlite_classes": ["ProjectStateDO"] }
  ],
  "observability": { "enabled": false }
  // Approval-gated template only: replace the all-zero KV ID after explicit
  // approval and namespace creation. Put D_ROUTING_HMAC_KEY in Worker Secrets;
  // never place its value here. No D1, route, custom domain, or live identifier.
}
