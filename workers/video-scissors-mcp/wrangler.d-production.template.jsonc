{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "video-scissors-mcp-d",
  "main": "src/index-d.ts",
  "compatibility_date": "2026-10-13",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "vars": { "EXPERIMENT_ENABLED": "false" },
  "assets": { "directory": "../../out", "binding": "ASSETS", "run_worker_first": true },
  "kv_namespaces": [
    { "binding": "OAUTH_KV", "id": "00000000000000000000000000000000" }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "PROJECT_STATE", "class_name": "ProjectStateDO" }
    ]
  },
  "migrations": [
    { "tag": "d-v1-sqlite-project-state", "new_sqlite_classes": ["ProjectStateDO"] }
  ],
  "observability": { "enabled": false }
  // Production release: exact dedicated production OAuth KV only.
  // Keep this tracked template DISABLED. Operator copies to ignored .env config,
  // injects only the dedicated KV ID and explicitly enables after independent
  // production HMAC secret installation and disabled-state readback.
  // Never store HMAC secret, KV identifier, media bytes or user data in repo.
  // No D1, route, custom domain or shared staging/A/B bindings.
}
