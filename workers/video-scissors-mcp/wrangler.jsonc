{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "video-scissors-mcp-local-only",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-13",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "vars": {"EXPERIMENT_ENABLED": "false"},
  "assets": {"directory": "../../out", "binding": "ASSETS", "run_worker_first": true},
  "d1_databases": [{"binding": "DB", "database_name": "video-scissors-local-only", "database_id": "00000000-0000-0000-0000-000000000000", "migrations_dir": "migrations"}],
  "kv_namespaces": [{"binding": "OAUTH_KV", "id": "00000000000000000000000000000000"}],
  "observability": {"enabled": false}
}
