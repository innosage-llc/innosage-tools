{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "video-scissors-mcp-d-candidate-local",
  "main": "src/index-d.ts",
  "compatibility_date": "2026-10-13",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "vars": { "EXPERIMENT_ENABLED": "false" },
  "assets": { "directory": "../../out", "binding": "ASSETS", "run_worker_first": true },
  "kv_namespaces": [
    { "binding": "OAUTH_KV", "id": "00000000000000000000000000000000" }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "PROJECT_STATE", "class_name": "ProjectStateDO" }
    ]
  },
  "migrations": [
    { "tag": "d-v1-sqlite-project-state", "new_sqlite_classes": ["ProjectStateDO"] }
  ],
  "observability": { "enabled": false }
  // No D1, routes, custom domains, live identifiers, or credentials.
  // D_ROUTING_HMAC_KEY is a future secret only; never put its value in this file.
}
